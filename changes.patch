index 0000000000..8a932a6f45
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift
@@ -0,0 +1,142 @@
+import Foundation
+import UIKit
+
+/// The censor bar over a banned word: a strip of paper laid across it. It is slightly tilted and casts a soft shadow,
+/// and when it appears it is pressed on from left to right: the part not yet stuck down is lifted and bent, and
+/// settles flat as the strip reaches the end.
+public final class WordBanCensorStripView: UIView {
+    /// The strip's tilt, counter-clockwise (the Figma reference: 1.35°).
+    public static let defaultTilt: CGFloat = -1.35 * .pi / 180.0
+
+    private let shapeLayer = CAShapeLayer()
+    private var currentSize = CGSize()
+
+    public var color: UIColor = .black {
+        didSet {
+            self.shapeLayer.fillColor = self.color.cgColor
+        }
+    }
+
+    override public init(frame: CGRect) {
+        super.init(frame: frame)
+
+        self.isUserInteractionEnabled = false
+        self.layer.addSublayer(self.shapeLayer)
+        self.shapeLayer.fillColor = self.color.cgColor
+        self.shapeLayer.shadowColor = UIColor.black.cgColor
+        self.shapeLayer.shadowOpacity = 0.24
+        self.shapeLayer.shadowRadius = 4.0
+        self.shapeLayer.shadowOffset = CGSize(width: 0.0, height: 2.0)
+    }
+
+    required public init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// Lays the strip out flat at `size` (set the view's bounds and center from outside; the tilt is a transform).
+    public func update(size: CGSize, tilt: CGFloat = WordBanCensorStripView.defaultTilt) {
+        self.transform = CGAffineTransform(rotationAngle: tilt)
+        if self.currentSize == size {
+            // A relayout of the same strip keeps a press-on animation running.
+            return
+        }
+        self.currentSize = size
+        self.shapeLayer.frame = CGRect(origin: CGPoint(), size: size)
+        self.shapeLayer.removeAnimation(forKey: "path")
+        self.shapeLayer.removeAnimation(forKey: "shadowOpacity")
+        self.shapeLayer.path = WordBanCensorStripView.path(size: size, progress: 1.0)
+    }
+
+    /// Presses the strip on from left to right. Under Reduce Motion it fades in instead.
+    public func animateIn(duration: Double = 0.45, delay: Double = 0.0) {
+        let size = self.currentSize
+        if size.width <= 0.0 || size.height <= 0.0 {
+            return
+        }
+        if UIAccessibility.isReduceMotionEnabled {
+            self.layer.animateAlphaFade(duration: 0.2, delay: delay)
+            return
+        }
+
+        // A critically damped spring on the progress: fast start, soft landing, no overshoot past the word.
+        let frameCount = 36
+        let omega = 9.0 / duration
+        var paths: [CGPath] = []
+        var shadows: [NSNumber] = []
+        for i in 0 ... frameCount {
+            let t = duration * Double(i) / Double(frameCount)
+            let progress = i == frameCount ? 1.0 : 1.0 - (1.0 + omega * t) * exp(-omega * t)
+            paths.append(WordBanCensorStripView.path(size: size, progress: CGFloat(progress)))
+            // A lifted flap throws a deeper shadow.
+            shadows.append(NSNumber(value: 0.24 + 0.16 * (1.0 - progress)))
+        }
+
+        let pathAnimation = CAKeyframeAnimation(keyPath: "path")
+        pathAnimation.values = paths
+        pathAnimation.duration = duration
+        pathAnimation.beginTime = CACurrentMediaTime() + delay
+        pathAnimation.fillMode = .backwards
+        pathAnimation.calculationMode = .linear
+        self.shapeLayer.add(pathAnimation, forKey: "path")
+
+        let shadowAnimation = CAKeyframeAnimation(keyPath: "shadowOpacity")
+        shadowAnimation.values = shadows
+        shadowAnimation.duration = duration
+        shadowAnimation.beginTime = pathAnimation.beginTime
+        shadowAnimation.fillMode = .backwards
+        self.shapeLayer.add(shadowAnimation, forKey: "shadowOpacity")
+    }
+
+    /// The strip with its first `progress` of the length stuck down. The rest is a flap lifted off the surface: it bends
+    /// up along a curve and is drawn a little thicker, being closer to the eye. Every path has the same number of
+    /// points, so the keyframes interpolate smoothly.
+    static func path(size: CGSize, progress: CGFloat) -> CGPath {
+        let length = size.width
+        let thickness = size.height
+        let progress = max(0.0, min(1.0, progress))
+
+        let attached = length * progress
+        let flapLength = min(length - attached, max(thickness * 2.4, length * 0.35) * (1.0 - progress))
+        let lift = thickness * 1.3 * (1.0 - progress)
+
+        let sampleCount = 10
+        var top: [CGPoint] = []
+        var bottom: [CGPoint] = []
+
+        // The stuck part: a flat run from the left edge to the attachment line.
+        top.append(CGPoint(x: 0.0, y: 0.0))
+        bottom.append(CGPoint(x: 0.0, y: thickness))
+        for i in 0 ... sampleCount {
+            let f = CGFloat(i) / CGFloat(sampleCount)
+            let x = attached + flapLength * f
+            let bend = f * f
+            let dy = -lift * bend
+            let grow = thickness * 0.18 * bend * (1.0 - progress)
+            top.append(CGPoint(x: x, y: dy - grow * 0.5))
+            bottom.append(CGPoint(x: x, y: thickness + dy + grow * 0.5))
+        }
+
+        let path = CGMutablePath()
+        path.move(to: top[0])
+        for point in top.dropFirst() {
+            path.addLine(to: point)
+        }
+        for point in bottom.reversed() {
+            path.addLine(to: point)
+        }
+        path.closeSubpath()
+        return path
+    }
+}
+
+private extension CALayer {
+    func animateAlphaFade(duration: Double, delay: Double) {
+        let animation = CABasicAnimation(keyPath: "opacity")
+        animation.fromValue = 0.0
+        animation.toValue = 1.0
+        animation.duration = duration
+        animation.beginTime = CACurrentMediaTime() + delay
+        animation.fillMode = .backwards
+        self.add(animation, forKey: "opacity")
+    }
+}
