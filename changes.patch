diff --git a/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift
new file mode 100644
index 0000000000..76361f20f7
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift
@@ -0,0 +1,240 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+
+/// One-sided word ban: a word the user does not want to read in one chat. It only changes how this device shows
+/// incoming messages; the other side and the server know nothing about it.
+public enum WordBanMode: Int32, Codable, Equatable {
+    /// Blacked out: a solid bar over the word, as a censor would strike it.
+    case censor = 1
+    /// Shown as the user's own text or emoji.
+    case replace = 2
+}
+
+/// How long a ban lasts, as the duration picker offers it.
+public enum WordBanDuration: Int32, CaseIterable, Codable, Equatable {
+    case day = 86400
+    case week = 604800
+    case month = 2592000
+    case threeMonths = 7776000
+    case sixMonths = 15552000
+    case year = 31536000
+    case forever = 0
+
+    /// The ban's end as a unix time; nil for a ban without an end.
+    public func expirationTimestamp(from timestamp: Int32) -> Int32? {
+        if case .forever = self {
+            return nil
+        }
+        return timestamp + self.rawValue
+    }
+}
+
+public struct WordBanRule: Codable, Equatable {
+    public var word: String
+    public var mode: WordBanMode
+    public var replacement: String?
+    public var duration: WordBanDuration
+    /// Unix time the ban ends; nil: never.
+    public var expiresAt: Int32?
+
+    public init(word: String, mode: WordBanMode, replacement: String?, duration: WordBanDuration, expiresAt: Int32?) {
+        self.word = word
+        self.mode = mode
+        self.replacement = replacement
+        self.duration = duration
+        self.expiresAt = expiresAt
+    }
+
+    public func isActive(at timestamp: Int32) -> Bool {
+        if let expiresAt = self.expiresAt {
+            return expiresAt > timestamp
+        }
+        return true
+    }
+}
+
+/// A word as the ban stores and matches it: the selection without surrounding spaces and punctuation.
+public func wordBanNormalizedWord(_ text: String) -> String {
+    var trimSet = CharacterSet.whitespacesAndNewlines
+    trimSet.formUnion(.punctuationCharacters)
+    trimSet.formUnion(.symbols)
+    return text.trimmingCharacters(in: trimSet)
+}
+
+/// The bans of every chat. Kept on this device only (`UserDefaults`); the server would need its own storage for them to
+/// follow the account to other devices (see the feature's README). Reads are thread-safe: chat bubbles read the rules
+/// during their off-main layout.
+public final class WordBanStore {
+    public static let shared = WordBanStore()
+
+    private static let storageKey = "WordBan.Rules.v1"
+
+    private let lock = NSLock()
+    private var rulesByPeer: [Int64: [WordBanRule]] = [:]
+    /// Messages whose banned words the user chose to show; for this run of the app only.
+    private var revealedMessageIds = Set<EngineMessage.Id>()
+
+    private let updatedPipe = ValuePipe<EnginePeer.Id>()
+    /// Fires with the chat whose bans changed.
+    public var updated: Signal<EnginePeer.Id, NoError> {
+        return self.updatedPipe.signal()
+    }
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: WordBanStore.storageKey), let decoded = try? JSONDecoder().decode([Int64: [WordBanRule]].self, from: data) {
+            self.rulesByPeer = decoded
+        }
+    }
+
+    private func save() {
+        if let data = try? JSONEncoder().encode(self.rulesByPeer) {
+            UserDefaults.standard.set(data, forKey: WordBanStore.storageKey)
+        }
+    }
+
+    private static var now: Int32 {
+        return Int32(Date().timeIntervalSince1970)
+    }
+
+    /// The chat's bans that have not ended.
+    public func rules(peerId: EnginePeer.Id) -> [WordBanRule] {
+        let now = WordBanStore.now
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return (self.rulesByPeer[peerId.toInt64()] ?? []).filter { $0.isActive(at: now) }
+    }
+
+    public func rule(peerId: EnginePeer.Id, word: String) -> WordBanRule? {
+        let key = wordBanNormalizedWord(word).lowercased()
+        return self.rules(peerId: peerId).first(where: { $0.word.lowercased() == key })
+    }
+
+    public func setRule(peerId: EnginePeer.Id, rule: WordBanRule) {
+        self.lock.lock()
+        var rules = self.rulesByPeer[peerId.toInt64()] ?? []
+        rules.removeAll(where: { $0.word.lowercased() == rule.word.lowercased() })
+        rules.append(rule)
+        self.rulesByPeer[peerId.toInt64()] = rules
+        self.save()
+        self.lock.unlock()
+        self.updatedPipe.putNext(peerId)
+    }
+
+    public func removeRule(peerId: EnginePeer.Id, word: String) {
+        let key = wordBanNormalizedWord(word).lowercased()
+        self.lock.lock()
+        var rules = self.rulesByPeer[peerId.toInt64()] ?? []
+        rules.removeAll(where: { $0.word.lowercased() == key })
+        self.rulesByPeer[peerId.toInt64()] = rules.isEmpty ? nil : rules
+        self.save()
+        self.lock.unlock()
+        self.updatedPipe.putNext(peerId)
+    }
+
+    public func removeAll() {
+        self.lock.lock()
+        self.rulesByPeer = [:]
+        self.revealedMessageIds.removeAll()
+        self.save()
+        self.lock.unlock()
+    }
+
+    public func isRevealed(messageId: EngineMessage.Id) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.revealedMessageIds.contains(messageId)
+    }
+
+    public func setRevealed(messageId: EngineMessage.Id, revealed: Bool) {
+        self.lock.lock()
+        if revealed {
+            self.revealedMessageIds.insert(messageId)
+        } else {
+            self.revealedMessageIds.remove(messageId)
+        }
+        self.lock.unlock()
+    }
+}
+
+/// A banned word as one message contains it.
+public struct WordBanMatch: Equatable {
+    public let rule: WordBanRule
+    /// UTF-16 range in the message text.
+    public let range: NSRange
+}
+
+/// Whole-word, case-insensitive occurrences of the banned words in `text`, in text order.
+public func wordBanMatches(text: String, rules: [WordBanRule]) -> [WordBanMatch] {
+    if text.isEmpty || rules.isEmpty {
+        return []
+    }
+    let nsText = text as NSString
+    var result: [WordBanMatch] = []
+    for rule in rules {
+        let word = wordBanNormalizedWord(rule.word)
+        if word.isEmpty {
+            continue
+        }
+        let pattern = "(?<![\\p{L}\\p{N}_])" + NSRegularExpression.escapedPattern(for: word) + "(?![\\p{L}\\p{N}_])"
+        guard let expression = try? NSRegularExpression(pattern: pattern, options: [.caseInsensitive]) else {
+            continue
+        }
+        for match in expression.matches(in: text, options: [], range: NSRange(location: 0, length: nsText.length)) {
+            if !result.contains(where: { NSIntersectionRange($0.range, match.range).length > 0 }) {
+                result.append(WordBanMatch(rule: rule, range: match.range))
+            }
+        }
+    }
+    return result.sorted(by: { $0.range.location < $1.range.location })
+}
+
+/// The text a message shows with its banned words applied: the user's text in place of replaced words, and the ranges
+/// (in the resulting text) of censored words, which the bubble covers with bars. Entity ranges move with the
+/// replacements. Nil when the text has no banned word.
+public func wordBanApply(text: String, entities: [MessageTextEntity]?, rules: [WordBanRule]) -> (text: String, entities: [MessageTextEntity], censoredRanges: [NSRange])? {
+    let matches = wordBanMatches(text: text, rules: rules)
+    if matches.isEmpty {
+        return nil
+    }
+    let result = NSMutableString(string: text)
+    var resultEntities = entities ?? []
+    var censoredRanges: [Range<Int>] = []
+
+    // From the end, so earlier ranges stay valid while later ones change length.
+    for match in matches.reversed() {
+        let start = match.range.location
+        let end = match.range.location + match.range.length
+        switch match.rule.mode {
+        case .censor:
+            censoredRanges.append(start ..< end)
+        case .replace:
+            let replacement = match.rule.replacement ?? ""
+            let replacementLength = (replacement as NSString).length
+            let delta = replacementLength - match.range.length
+            result.replaceCharacters(in: match.range, with: replacement)
+            resultEntities = resultEntities.compactMap { entity in
+                var entity = entity
+                let lower = entity.range.lowerBound
+                let upper = entity.range.upperBound
+                if upper <= start {
+                    return entity
+                }
+                if lower >= end {
+                    entity.range = (lower + delta) ..< (upper + delta)
+                    return entity
+                }
+                // Overlaps the replaced word: keep what is outside it, the replacement joins the entity.
+                let newLower = lower < start ? lower : start
+                let newUpper = upper > end ? upper + delta : start + replacementLength
+                if newUpper <= newLower {
+                    return nil
+                }
+                entity.range = newLower ..< newUpper
+                return entity
+            }
+            censoredRanges = censoredRanges.map { ($0.lowerBound + delta) ..< ($0.upperBound + delta) }
+        }
+    }
+    return (result as String, resultEntities, censoredRanges.map { NSRange(location: $0.lowerBound, length: $0.upperBound - $0.lowerBound) })
+}
diff --git a/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift
