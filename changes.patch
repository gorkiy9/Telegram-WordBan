+                            pressedColor: theme.list.itemCheckColors.fillColor.withMultipliedAlpha(0.9)
+                        ),
+                        content: AnyComponentWithIdentity(
+                            id: AnyHashable(buttonTitle),
+                            component: AnyComponent(MultilineTextComponent(text: .plain(NSAttributedString(string: buttonTitle, font: Font.semibold(17.0), textColor: theme.list.itemCheckColors.foregroundColor, paragraphAlignment: .center))))
+                        ),
+                        isEnabled: isEnabled,
+                        action: { [weak state] in
+                            state?.complete()
+                        }
+                    ),
+                    availableSize: CGSize(width: banButtonWidth, height: 52.0),
+                    transition: context.transition
+                )
+                context.add(banButton
+                    .position(CGPoint(x: buttonInsets.left + banButton.size.width / 2.0, y: contentHeight + banButton.size.height / 2.0))
+                    .appear(.default(scale: true, alpha: true))
+                    .disappear(.default(scale: true, alpha: true))
+                )
+            }
+            if showsBanButton {
+                contentHeight += 52.0
+            } else {
+                contentHeight -= 16.0
+            }
+
+            if environment.inputHeight > 0.0 {
+                contentHeight += 15.0
+                contentHeight += max(environment.inputHeight, environment.safeInsets.bottom)
+            } else {
+                contentHeight += buttonInsets.bottom
+            }
+
+            return CGSize(width: context.availableSize.width, height: contentHeight)
+        }
+    }
+}
