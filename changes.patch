+private final class WordBanSheetContent: CombinedComponent {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let word: String
+    let initialRule: WordBanRule?
+    let dismiss: () -> Void
+
+    init(context: AccountContext, word: String, initialRule: WordBanRule?, dismiss: @escaping () -> Void) {
+        self.context = context
+        self.word = word
+        self.initialRule = initialRule
+        self.dismiss = dismiss
+    }
+
+    static func ==(lhs: WordBanSheetContent, rhs: WordBanSheetContent) -> Bool {
+        if lhs.context !== rhs.context {
+            return false
+        }
+        if lhs.word != rhs.word {
+            return false
+        }
+        if lhs.initialRule != rhs.initialRule {
+            return false
+        }
+        return true
+    }
+
+    final class State: ComponentState {
+        var option: WordBanOption
+        var replacement: String
+        var duration: WordBanDuration
+        var includesSimilar: Bool
+        /// Set when the user picks Censored, so the strip is pressed on as in the chat; a sheet opened on a censored
