+        var animatesCensorStrip = false
+        weak var controller: ViewController?
+
+        init(initialRule: WordBanRule?) {
+            // A word without a ban starts on Visible, its current state; the ban button shows once a ban is picked.
+            self.option = WordBanOption(mode: initialRule?.mode)
+            self.replacement = initialRule?.replacement ?? ""
+            self.duration = initialRule?.duration ?? .week
+            // On for a new ban: people dodge a ban by stretching or bending the word.
+            self.includesSimilar = initialRule?.includesSimilar ?? true
+            super.init()
+        }
+
+        func complete() {
+            (self.controller as? WordBanScreen)?.complete(option: self.option, replacement: self.replacement, duration: self.duration, includesSimilar: self.includesSimilar)
+        }
+
+        /// How long the ban lasts, on a wheel: the client's timer picker sheet, as for auto-delete.
+        func openDurationPicker(context: AccountContext) {
+            guard let controller = self.controller else {
+                return
+            }
+            let values = WordBanDuration.allCases.map(\.rawValue)
+            let picker = ChatTimerScreen(
+                context: context,
+                configuration: ChatTimerScreen.Configuration(
+                    style: .default,
+                    title: { strings in
+                        strings.WordBan_Duration_Title
+                    },
+                    picker: .fixedValues(
+                        values: values,
+                        selectionStrategy: .exact,
+                        formatter: { strings, value in
+                            guard let duration = WordBanDuration(rawValue: value) else {
+                                return ""
+                            }
+                            return durationTitle(duration, strings: strings)
+                        }
+                    ),
+                    currentValue: self.duration.rawValue,
+                    pickerValueMapping: .rawTimestamp,
