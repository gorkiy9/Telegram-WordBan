+import Foundation
+import UIKit
+import CoreText
+import Display
+import ComponentFlow
+import ChatWordBan
+
+/// The censor strip in the sheet's preview: pressed on when Censored is picked, laid flat when the sheet opens on it.
+final class WordBanCensorStripComponent: Component {
+    let color: UIColor
+
+    init(color: UIColor) {
+        self.color = color
+    }
+
+    static func ==(lhs: WordBanCensorStripComponent, rhs: WordBanCensorStripComponent) -> Bool {
+        return lhs.color.isEqual(rhs.color)
+    }
+
+    final class View: UIView {
+        private let stripView = WordBanCensorStripView()
+        private var isLaidOut = false
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.addSubview(self.stripView)
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        func update(component: WordBanCensorStripComponent, availableSize: CGSize, transition: ComponentTransition) -> CGSize {
+            self.stripView.color = component.color
+            self.stripView.bounds = CGRect(origin: CGPoint(), size: availableSize)
+            self.stripView.center = CGPoint(x: availableSize.width / 2.0, y: availableSize.height / 2.0)
+            self.stripView.update(size: availableSize)
+            if !self.isLaidOut {
+                self.isLaidOut = true
+                if case .none = transition.animation {
+                } else {
+                    self.stripView.animateIn()
+                }
+            }
+            return availableSize
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, transition: transition)
+    }
+}
+
+/// The banned word under its replacement: it shrinks and fades out downwards as soon as the user types, so the new
+/// word reads on top of it. Scaling is a uniform transform, so the letters never stretch.
+final class WordBanFadedWordComponent: Component {
+    let text: String
+    let font: UIFont
+    let color: UIColor
+    let isFaded: Bool
+
+    init(text: String, font: UIFont, color: UIColor, isFaded: Bool) {
+        self.text = text
+        self.font = font
+        self.color = color
+        self.isFaded = isFaded
+    }
+
+    static func ==(lhs: WordBanFadedWordComponent, rhs: WordBanFadedWordComponent) -> Bool {
+        return lhs.text == rhs.text && lhs.font == rhs.font && lhs.color.isEqual(rhs.color) && lhs.isFaded == rhs.isFaded
+    }
+
+    /// The reference sizes: 34 pt for the word, 28 pt once a replacement covers it.
+    private static let fadedScale: CGFloat = 28.0 / 34.0
+
+    final class View: UIView {
+        private let label = UILabel()
+        private let maskLayer = CAGradientLayer()
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.addSubview(self.label)
+            self.maskLayer.startPoint = CGPoint(x: 0.5, y: 0.0)
+            self.maskLayer.endPoint = CGPoint(x: 0.5, y: 1.0)
+            self.label.layer.mask = self.maskLayer
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        func update(component: WordBanFadedWordComponent, availableSize: CGSize, transition: ComponentTransition) -> CGSize {
+            self.label.attributedText = NSAttributedString(string: component.text, font: component.font, textColor: component.color)
+            self.label.lineBreakMode = .byTruncatingTail
+            var size = self.label.sizeThatFits(CGSize(width: availableSize.width, height: .greatestFiniteMagnitude))
+            size.width = min(ceil(size.width), availableSize.width)
+            size.height = ceil(size.height)
+
+            self.label.bounds = CGRect(origin: CGPoint(), size: size)
+            transition.setPosition(view: self.label, position: CGPoint(x: size.width / 2.0, y: size.height / 2.0))
+            transition.setScale(view: self.label, scale: component.isFaded ? WordBanFadedWordComponent.fadedScale : 1.0)
+
+            // Faded: grey at the top, gone at the bottom (the reference's gradient into the sheet's background).
+            self.maskLayer.frame = CGRect(origin: CGPoint(), size: size)
+            let topAlpha: CGFloat = component.isFaded ? 0.3 : 1.0
+            let bottomAlpha: CGFloat = component.isFaded ? 0.0 : 1.0
+            let colors = [UIColor(white: 0.0, alpha: topAlpha).cgColor, UIColor(white: 0.0, alpha: bottomAlpha).cgColor]
+            let previousColors = self.maskLayer.presentation()?.colors ?? self.maskLayer.colors
+            self.maskLayer.colors = colors
+            if case let .curve(duration, _) = transition.animation, let previousColors {
+                let animation = CABasicAnimation(keyPath: "colors")
+                animation.fromValue = previousColors
+                animation.toValue = colors
+                animation.duration = duration
+                animation.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+                self.maskLayer.add(animation, forKey: "colors")
+            }
+            return size
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, transition: transition)
+    }
+}
+
+/// The replacement as the user types it, one character at a time: each new character springs in where it will stay,
+/// the others slide over to keep the word centred, and removed ones fade out. Every character is its own label laid
+/// out from the whole line, so a change never stretches the letters already shown.
+final class WordBanReplacementTextComponent: Component {
+    let text: String
+    let font: UIFont
+    let color: UIColor
+
+    init(text: String, font: UIFont, color: UIColor) {
+        self.text = text
+        self.font = font
+        self.color = color
+    }
+
+    static func ==(lhs: WordBanReplacementTextComponent, rhs: WordBanReplacementTextComponent) -> Bool {
+        return lhs.text == rhs.text && lhs.font == rhs.font && lhs.color.isEqual(rhs.color)
+    }
+
+    final class View: UIView {
+        private final class CharacterItem {
+            let character: Character
+            let label: UILabel
+
+            init(character: Character) {
+                self.character = character
+                self.label = UILabel()
+            }
+        }
+
+        private var items: [CharacterItem] = []
+
+        func update(component: WordBanReplacementTextComponent, availableSize: CGSize, transition: ComponentTransition) -> CGSize {
+            let characters = Array(component.text)
+
+            // Keep the characters shared with the previous text (common prefix and suffix); everything between is new.
+            var prefix = 0
+            while prefix < characters.count && prefix < self.items.count && self.items[prefix].character == characters[prefix] {
+                prefix += 1
+            }
+            var suffix = 0
+            while suffix < characters.count - prefix && suffix < self.items.count - prefix && self.items[self.items.count - 1 - suffix].character == characters[characters.count - 1 - suffix] {
+                suffix += 1
+            }
+            let removed = Array(self.items[prefix ..< (self.items.count - suffix)])
+            var inserted: [CharacterItem] = []
+            for character in characters[prefix ..< (characters.count - suffix)] {
+                inserted.append(CharacterItem(character: character))
+            }
+            self.items = Array(self.items[0 ..< prefix]) + inserted + Array(self.items[(self.items.count - suffix)...])
+
+            // Positions from the whole line, so kerning and emoji widths match the text as one string.
+            let attributedText = NSAttributedString(string: component.text, font: component.font, textColor: component.color)
+            let line = CTLineCreateWithAttributedString(attributedText)
+            let lineWidth = ceil(CTLineGetTypographicBounds(line, nil, nil, nil))
+            let height = ceil(component.font.lineHeight)
+            let scale = lineWidth > availableSize.width && lineWidth > 0.0 ? availableSize.width / lineWidth : 1.0
+            let size = CGSize(width: min(lineWidth, availableSize.width), height: height)
+
+            let reduceMotion = UIAccessibility.isReduceMotionEnabled
+            var utf16Offset = 0
+            for item in self.items {
+                let length = String(item.character).utf16.count
+                let startX = CTLineGetOffsetForStringIndex(line, utf16Offset, nil)
+                let endX = CTLineGetOffsetForStringIndex(line, utf16Offset + length, nil)
+                utf16Offset += length
+
+                let label = item.label
+                label.attributedText = NSAttributedString(string: String(item.character), font: component.font, textColor: component.color)
+                let labelSize = label.sizeThatFits(CGSize(width: CGFloat.greatestFiniteMagnitude, height: height))
+                let center = CGPoint(x: (startX + endX) / 2.0 * scale, y: height / 2.0)
+                label.bounds = CGRect(origin: CGPoint(), size: CGSize(width: ceil(labelSize.width), height: height))
+
+                if label.superview == nil {
+                    self.addSubview(label)
+                    label.center = center
+                    label.transform = CGAffineTransform(scaleX: scale, y: scale)
+                    if case .none = transition.animation {
+                    } else {
+                        // New characters follow one another by 30 ms when several arrive at once (paste).
+                        let delay = Double(inserted.firstIndex(where: { $0 === item }) ?? 0) * 0.03
+                        label.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.18, delay: delay)
+                        if !reduceMotion {
+                            label.layer.animateSpring(from: 0.4 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.45, delay: delay, damping: 70.0)
+                            label.layer.animateSpring(from: NSValue(cgPoint: CGPoint(x: 0.0, y: height * 0.35)), to: NSValue(cgPoint: CGPoint()), keyPath: "position", duration: 0.45, delay: delay, damping: 70.0, additive: true)
+                        }
+                    }
+                } else {
+                    transition.setPosition(view: label, position: center)
+                    transition.setTransform(view: label, transform: CATransform3DMakeScale(scale, scale, 1.0))
+                }
+            }
+
+            for item in removed {
+                let label = item.label
+                if case .none = transition.animation {
+                    label.removeFromSuperview()
+                } else {
+                    label.layer.animateAlpha(from: label.alpha, to: 0.0, duration: 0.15, removeOnCompletion: false, completion: { [weak label] _ in
+                        label?.removeFromSuperview()
+                    })
+                    if !reduceMotion {
+                        label.layer.animateScale(from: 1.0, to: 0.4, duration: 0.15, removeOnCompletion: false)
+                    }
+                }
+            }
+
+            return size
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, transition: transition)
+    }
+}
