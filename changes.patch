diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Messages/WordBanDemo.swift b/submodules/TelegramCore/Sources/TelegramEngine/Messages/WordBanDemo.swift
new file mode 100644
index 0000000000..c0fc75da26
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Messages/WordBanDemo.swift
@@ -0,0 +1,190 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// Word ban concept: the build used to record the demo video. It is a separate app (its bundle id contains
+/// "WordBanDemo", so it has its own data container and never sees the regular app's account). It never connects to a
+/// server: the account, its chats and their messages are local stand-ins that exist on this device only.
+public let isWordBanDemoBuild: Bool = {
+    guard let bundleId = Bundle.main.bundleIdentifier else {
+        return false
+    }
+    return bundleId.contains("WordBanDemo")
+}()
+
+private let wordBanDemoPeerIdBase: Int64 = 1_099_511_627_100
+private let wordBanDemoPeerIdCount: Int64 = 100
+
+/// The demo's local users and groups: ids the server never assigns to real peers in this account.
+public func wordBanDemoPeerId(index: Int, isGroup: Bool) -> EnginePeer.Id {
+    return PeerId(namespace: isGroup ? Namespaces.Peer.CloudGroup : Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(wordBanDemoPeerIdBase + Int64(index)))
+}
+
+/// A demo peer: its history is local, and messages sent to it are stored as delivered.
+func isWordBanDemoPeer(_ peerId: PeerId) -> Bool {
+    guard isWordBanDemoBuild else {
+        return false
+    }
+    guard peerId.namespace == Namespaces.Peer.CloudUser || peerId.namespace == Namespaces.Peer.CloudGroup else {
+        return false
+    }
+    let value = peerId.id._internalGetInt64Value()
+    return value >= wordBanDemoPeerIdBase && value < wordBanDemoPeerIdBase + wordBanDemoPeerIdCount
+}
+
+/// What the demo puts in the account: its chats and their messages.
+public struct WordBanDemoSeed {
+    public enum PeerKind {
+        case user(firstName: String, lastName: String?)
+        case group(title: String, memberCount: Int)
+    }
+
+    public struct Peer {
+        public let id: EnginePeer.Id
+        public let kind: PeerKind
+        /// Unread incoming messages the chat list shows.
+        public let unreadCount: Int32
+        /// The profile photo, a square JPEG; nil keeps the default initials avatar.
+        public let photo: Data?
+
+        public init(id: EnginePeer.Id, kind: PeerKind, unreadCount: Int32 = 0, photo: Data? = nil) {
+            self.id = id
+            self.kind = kind
+            self.unreadCount = unreadCount
+            self.photo = photo
+        }
+    }
+
+    public struct Message {
+        public let peerId: EnginePeer.Id
+        public let id: Int32
+        /// Nil: sent by the account.
+        public let authorId: EnginePeer.Id?
+        public let timestamp: Int32
+        public let text: String
+
+        public init(peerId: EnginePeer.Id, id: Int32, authorId: EnginePeer.Id?, timestamp: Int32, text: String) {
+            self.peerId = peerId
+            self.id = id
+            self.authorId = authorId
+            self.timestamp = timestamp
+            self.text = text
+        }
+    }
+
+    public let peers: [Peer]
+    public let messages: [Message]
+
+    public init(peers: [Peer], messages: [Message]) {
+        self.peers = peers
+        self.messages = messages
+    }
+}
+
+public extension TelegramEngine.Messages {
+    /// Writes the demo's chats from scratch: earlier demo messages (also those sent while recording) are dropped, so every
+    /// take starts from the same state. Chats that are not the demo's leave the chat list.
+    func seedWordBanDemo(_ seed: WordBanDemoSeed) -> Signal<Never, NoError> {
+        guard isWordBanDemoBuild else {
+            return .complete()
+        }
+        let accountPeerId = self.account.peerId
+        let mediaBox = self.account.postbox.mediaBox
+        return self.account.postbox.transaction { transaction -> Void in
+            var peers: [Peer] = []
+            var presences: [PeerId: PeerPresence] = [:]
+            for peer in seed.peers {
+                // The photo is a local file: its id is the peer's (with the namespace, so a user and a group with the same
+                // index don't share it), and a reseed overwrites the same file.
+                var photo: [TelegramMediaImageRepresentation] = []
+                if let data = peer.photo {
+                    let resource = LocalFileMediaResource(fileId: peer.id.toInt64())
+                    mediaBox.storeResourceData(resource.id, data: data, synchronous: true)
+                    photo.append(TelegramMediaImageRepresentation(dimensions: PixelDimensions(width: 400, height: 400), resource: resource, progressiveSizes: [], immediateThumbnailData: nil, hasVideo: false, isPersonal: false))
+                }
+                switch peer.kind {
+                case let .user(firstName, lastName):
+                    presences[peer.id] = TelegramUserPresence(status: .recently(isHidden: false), lastActivity: 0)
+                    // An access hash makes the user referable (`PeerReference`), which the chat list needs to show the photo.
+                    peers.append(TelegramUser(id: peer.id, accessHash: .personal(peer.id.toInt64()), firstName: firstName, lastName: lastName, username: nil, phone: nil, photo: photo, botInfo: nil, restrictionInfo: nil, flags: [], emojiStatus: nil, usernames: [], storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil, profileBackgroundEmojiId: nil, subscriberCount: nil, verificationIconFileId: nil))
+                case let .group(title, memberCount):
+                    peers.append(TelegramGroup(id: peer.id, title: title, photo: photo, participantCount: memberCount, role: .member, membership: .Member, flags: [], defaultBannedRights: nil, migrationReference: nil, creationDate: 0, version: 0))
+                }
+            }
+            transaction.updatePeersInternal(peers, update: { _, updated in
+                return updated
+            })
+            // Every demo user was seen recently: the chat header reads "last seen recently".
+            transaction.updatePeerPresencesInternal(presences: presences, merge: { _, updated in
+                return updated
+            })
+
+            // The demo is offline: the chat lists have nothing to load from a server.
+            for groupId in [PeerGroupId.root, Namespaces.PeerGroup.archive] {
+                for hole in transaction.allChatListHoles(groupId: groupId) {
+                    transaction.replaceChatListHole(groupId: groupId, index: hole.index, hole: nil)
+                }
+            }
+
+            // Everything already in the chat list that is not the demo's leaves it.
+            let demoPeerIds = Set(seed.peers.map(\.id))
+            for peerId in transaction.getChatListPeers(groupId: .root, filterPredicate: nil, additionalFilter: nil).map(\.id) where !demoPeerIds.contains(peerId) {
+                transaction.updatePeerChatListInclusion(peerId, inclusion: .notIncluded)
+            }
+
+            for peer in seed.peers {
+                transaction.clearHistory(peer.id, threadId: nil, minTimestamp: nil, maxTimestamp: nil, namespaces: .all, forEachMedia: nil)
+                transaction.removeHole(peerId: peer.id, threadId: nil, namespace: Namespaces.Message.Cloud, space: .everywhere, range: 1 ... (Int32.max - 1))
+                if peer.id.namespace == Namespaces.Peer.CloudUser {
+                    // A user chat waits for the profile's business intro; the server has no profile for these peers.
+                    transaction.updatePeerCachedData(peerIds: Set([peer.id]), update: { _, current in
+                        let cachedData = (current as? CachedUserData) ?? CachedUserData()
+                        return cachedData.withUpdatedBusinessIntro(nil)
+                    })
+                }
+            }
+
+            var storeMessages: [StoreMessage] = []
+            for message in seed.messages {
+                let isIncoming = message.authorId != nil
+                let (tags, globalTags) = tagsForStoreMessage(incoming: isIncoming, attributes: [], media: [], textEntities: nil, isPinned: false)
+                storeMessages.append(StoreMessage(id: MessageId(peerId: message.peerId, namespace: Namespaces.Message.Cloud, id: message.id), customStableId: nil, globallyUniqueId: nil, groupingKey: nil, threadId: nil, timestamp: message.timestamp, flags: isIncoming ? [.Incoming] : [], tags: tags, globalTags: globalTags, localTags: [], forwardInfo: nil, authorId: message.authorId ?? accountPeerId, text: message.text, attributes: [], media: []))
+            }
+            let _ = transaction.addMessages(storeMessages, location: .UpperHistoryBlock)
+
+            var readStates: [PeerId: [MessageId.Namespace: PeerReadState]] = [:]
+            for peer in seed.peers {
+                let maxId = seed.messages.filter { $0.peerId == peer.id }.map(\.id).max() ?? 0
+                readStates[peer.id] = [Namespaces.Message.Cloud: .idBased(maxIncomingReadId: max(0, maxId - peer.unreadCount), maxOutgoingReadId: maxId, maxKnownId: maxId, count: peer.unreadCount, markedUnread: false)]
+                transaction.updatePeerChatListInclusion(peer.id, inclusion: .ifHasMessagesOrOneOf(groupId: .root, pinningIndex: nil, minTimestamp: nil))
+            }
+            transaction.resetIncomingReadStates(readStates)
+        }
+        |> ignoreValues
+    }
+}
+
+/// The demo build's own account: local only, never signed in anywhere.
+public let wordBanDemoAccountPeerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(1_099_511_627_050))
+
+/// Signs the demo build in without a server: the account is Alex Morgan, stored on this device only. The demo's
+/// network points at a closed local port (`initializedNetwork`), so nothing can sign it out again.
+public func wordBanDemoSignInOffline(accountManager: AccountManager<TelegramAccountManagerTypes>, account: UnauthorizedAccount) -> Signal<Never, NoError> {
+    guard isWordBanDemoBuild else {
+        return .complete()
+    }
+    return account.postbox.transaction { transaction -> Void in
+        let user = TelegramUser(id: wordBanDemoAccountPeerId, accessHash: nil, firstName: "Alex", lastName: "Morgan", username: "alexmorgan", phone: "15550100000", photo: [], botInfo: nil, restrictionInfo: nil, flags: [], emojiStatus: nil, usernames: [], storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil, profileBackgroundEmojiId: nil, subscriberCount: nil, verificationIconFileId: nil)
+        transaction.updatePeersInternal([user], update: { _, updated in
+            return updated
+        })
+        initializedAppSettingsAfterLogin(transaction: transaction, appVersion: account.networkArguments.appVersion, syncContacts: false)
+        transaction.setState(AuthorizedAccountState(isTestingEnvironment: true, masterDatacenterId: 2, peerId: wordBanDemoAccountPeerId, state: nil, invalidatedChannels: []))
+    }
+    |> mapToSignal { _ -> Signal<Void, NoError> in
+        return accountManager.transaction { transaction -> Void in
+            switchToAuthorizedAccount(transaction: transaction, account: account, isSupportUser: false)
+        }
+    }
+    |> ignoreValues
+}
