diff --git a/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift
new file mode 100644
index 0000000000..d3c011fd3c
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/ChatWordBan.swift
@@ -0,0 +1,319 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+
+/// One-sided word ban: a word the user does not want to read in one chat. It only changes how this device shows
+/// incoming messages; the other side and the server know nothing about it.
+public enum WordBanMode: Int32, Codable, Equatable {
+    /// Blacked out: a solid bar over the word, as a censor would strike it.
+    case censor = 1
+    /// Shown as the user's own text or emoji.
+    case replace = 2
+}
+
+/// How long a ban lasts, as the duration picker offers it.
+public enum WordBanDuration: Int32, CaseIterable, Codable, Equatable {
+    case day = 86400
+    case week = 604800
+    case month = 2592000
+    case threeMonths = 7776000
+    case sixMonths = 15552000
+    case year = 31536000
+    case forever = 0
+
+    /// The ban's end as a unix time; nil for a ban without an end.
+    public func expirationTimestamp(from timestamp: Int32) -> Int32? {
+        if case .forever = self {
+            return nil
+        }
+        return timestamp + self.rawValue
+    }
+}
+
+public struct WordBanRule: Codable, Equatable {
+    public var word: String
+    public var mode: WordBanMode
+    public var replacement: String?
+    public var duration: WordBanDuration
+    /// Unix time the ban ends; nil: never.
+    public var expiresAt: Int32?
+    /// "Similar words": the ban also catches the word stretched ("Йоооу"), its forms ("дедлайны") and its beginning
+    /// stretched ("Йооо"). Off: only the word itself, in any letter case.
+    public var includesSimilar: Bool
+
+    public init(word: String, mode: WordBanMode, replacement: String?, duration: WordBanDuration, expiresAt: Int32?, includesSimilar: Bool) {
+        self.word = word
+        self.mode = mode
+        self.replacement = replacement
+        self.duration = duration
+        self.expiresAt = expiresAt
+        self.includesSimilar = includesSimilar
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case word, mode, replacement, duration, expiresAt, includesSimilar
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.word = try container.decode(String.self, forKey: .word)
+        self.mode = try container.decode(WordBanMode.self, forKey: .mode)
+        self.replacement = try container.decodeIfPresent(String.self, forKey: .replacement)
+        self.duration = try container.decode(WordBanDuration.self, forKey: .duration)
+        self.expiresAt = try container.decodeIfPresent(Int32.self, forKey: .expiresAt)
+        // Bans saved before the option existed matched the word only.
+        self.includesSimilar = try container.decodeIfPresent(Bool.self, forKey: .includesSimilar) ?? false
+    }
+
+    public func isActive(at timestamp: Int32) -> Bool {
+        if let expiresAt = self.expiresAt {
+            return expiresAt > timestamp
+        }
+        return true
+    }
+}
+
+/// A word as the ban stores and matches it: the selection without surrounding spaces and punctuation.
+public func wordBanNormalizedWord(_ text: String) -> String {
+    var trimSet = CharacterSet.whitespacesAndNewlines
+    trimSet.formUnion(.punctuationCharacters)
+    trimSet.formUnion(.symbols)
+    return text.trimmingCharacters(in: trimSet)
+}
+
+/// The key two spellings of a banned word share when they differ only in letter case, mixed case included
+/// ("deadline", "Deadline", "DeAdLiNe", "DEADLINE"). Full Unicode case folding, so "straße" and "STRASSE" are one word too.
+public func wordBanKey(_ word: String) -> String {
+    return wordBanNormalizedWord(word).folding(options: [.caseInsensitive], locale: nil)
+}
+
+/// The bans of every chat. Kept on this device only (`UserDefaults`); the server would need its own storage for them to
+/// follow the account to other devices (see the feature's README). Reads are thread-safe: chat bubbles read the rules
+/// during their off-main layout.
+public final class WordBanStore {
+    public static let shared = WordBanStore()
+
+    private static let storageKey = "WordBan.Rules.v1"
+
+    private let lock = NSLock()
+    private var rulesByPeer: [Int64: [WordBanRule]] = [:]
+    /// Messages whose banned words the user chose to show; for this run of the app only.
+    private var revealedMessageIds = Set<EngineMessage.Id>()
+
+    private let updatedPipe = ValuePipe<EnginePeer.Id>()
+    /// Fires with the chat whose bans changed.
+    public var updated: Signal<EnginePeer.Id, NoError> {
+        return self.updatedPipe.signal()
+    }
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: WordBanStore.storageKey), let decoded = try? JSONDecoder().decode([Int64: [WordBanRule]].self, from: data) {
+            self.rulesByPeer = decoded
+        }
+    }
+
+    private func save() {
+        if let data = try? JSONEncoder().encode(self.rulesByPeer) {
+            UserDefaults.standard.set(data, forKey: WordBanStore.storageKey)
+        }
+    }
+
+    private static var now: Int32 {
+        return Int32(Date().timeIntervalSince1970)
+    }
+
+    /// The chat's bans that have not ended.
+    public func rules(peerId: EnginePeer.Id) -> [WordBanRule] {
+        let now = WordBanStore.now
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return (self.rulesByPeer[peerId.toInt64()] ?? []).filter { $0.isActive(at: now) }
+    }
+
+    public func rule(peerId: EnginePeer.Id, word: String) -> WordBanRule? {
+        let key = wordBanKey(word)
+        return self.rules(peerId: peerId).first(where: { wordBanKey($0.word) == key })
+    }
+
+    public func setRule(peerId: EnginePeer.Id, rule: WordBanRule) {
+        self.lock.lock()
+        var rules = self.rulesByPeer[peerId.toInt64()] ?? []
+        let key = wordBanKey(rule.word)
+        rules.removeAll(where: { wordBanKey($0.word) == key })
+        rules.append(rule)
+        self.rulesByPeer[peerId.toInt64()] = rules
+        self.save()
+        self.lock.unlock()
+        self.updatedPipe.putNext(peerId)
+    }
+
+    public func removeRule(peerId: EnginePeer.Id, word: String) {
+        let key = wordBanKey(word)
+        self.lock.lock()
+        var rules = self.rulesByPeer[peerId.toInt64()] ?? []
+        rules.removeAll(where: { wordBanKey($0.word) == key })
+        self.rulesByPeer[peerId.toInt64()] = rules.isEmpty ? nil : rules
+        self.save()
+        self.lock.unlock()
+        self.updatedPipe.putNext(peerId)
+    }
+
+    public func removeAll() {
+        self.lock.lock()
+        self.rulesByPeer = [:]
+        self.revealedMessageIds.removeAll()
+        self.save()
+        self.lock.unlock()
+    }
+
+    public func isRevealed(messageId: EngineMessage.Id) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.revealedMessageIds.contains(messageId)
+    }
+
+    public func setRevealed(messageId: EngineMessage.Id, revealed: Bool) {
+        self.lock.lock()
+        if revealed {
+            self.revealedMessageIds.insert(messageId)
+        } else {
+            self.revealedMessageIds.remove(messageId)
+        }
+        self.lock.unlock()
+    }
+}
+
+/// Whether a letter, digit or underscore touches a match at `index`, which would make the match part of a longer word.
+private func wordBanIsWordCharacter(_ text: NSString, before index: Int) -> Bool {
+    if index <= 0 {
+        return false
+    }
+    let range = text.rangeOfComposedCharacterSequence(at: index - 1)
+    return wordBanIsWordCharacter(text.substring(with: range))
+}
+
+private func wordBanIsWordCharacter(_ text: NSString, after index: Int) -> Bool {
+    if index >= text.length {
+        return false
+    }
+    let range = text.rangeOfComposedCharacterSequence(at: index)
+    return wordBanIsWordCharacter(text.substring(with: range))
+}
+
+private func wordBanIsWordCharacter(_ character: String) -> Bool {
+    if character == "_" {
+        return true
+    }
+    return character.unicodeScalars.first.flatMap { CharacterSet.alphanumerics.contains($0) } ?? false
+}
+
+/// A banned word as one message contains it.
+public struct WordBanMatch: Equatable {
+    public let rule: WordBanRule
+    /// UTF-16 range in the message text.
+    public let range: NSRange
+}
+
+/// Whole-word, case-insensitive occurrences of the banned words in `text`, in text order; for a ban with
+/// "Similar words" on, also the words similar to it (`WordBanSimilarPattern`), each covered whole.
+public func wordBanMatches(text: String, rules: [WordBanRule]) -> [WordBanMatch] {
+    if text.isEmpty || rules.isEmpty {
+        return []
+    }
+    let nsText = text as NSString
+    var result: [WordBanMatch] = []
+    var tokens: [(range: NSRange, token: String, lemma: String?)]?
+    for rule in rules where rule.includesSimilar {
+        if tokens == nil {
+            tokens = wordBanTokens(text)
+        }
+        let pattern = WordBanSimilarPattern(word: rule.word)
+        for token in tokens ?? [] where pattern.matches(token: token.token, tokenLemma: token.lemma) {
+            if !result.contains(where: { NSIntersectionRange($0.range, token.range).length > 0 }) {
+                result.append(WordBanMatch(rule: rule, range: token.range))
+            }
+        }
+    }
+    for rule in rules {
+        let word = wordBanNormalizedWord(rule.word)
+        if word.isEmpty {
+            continue
+        }
+        // Case-insensitive search with full Unicode case folding: any mix of upper and lower case matches,
+        // and the range stays in the original text even when folding changes the length ("STRASSE" for "straße").
+        var searchRange = NSRange(location: 0, length: nsText.length)
+        while searchRange.length > 0 {
+            let found = nsText.range(of: word, options: [.caseInsensitive], range: searchRange)
+            if found.location == NSNotFound {
+                break
+            }
+            searchRange = NSRange(location: found.location + 1, length: nsText.length - found.location - 1)
+            if wordBanIsWordCharacter(nsText, before: found.location) || wordBanIsWordCharacter(nsText, after: found.location + found.length) {
+                continue
+            }
+            if !result.contains(where: { NSIntersectionRange($0.range, found).length > 0 }) {
+                result.append(WordBanMatch(rule: rule, range: found))
+            }
+        }
+    }
+    return result.sorted(by: { $0.range.location < $1.range.location })
+}
+
+/// The text a message shows with its banned words applied: the user's text in place of replaced words, and the ranges
+/// (in the resulting text) of censored words, which the bubble covers with bars. Entity ranges move with the
+/// replacements. Nil when the text has no banned word.
+public func wordBanApply(text: String, entities: [MessageTextEntity]?, rules: [WordBanRule]) -> (text: String, entities: [MessageTextEntity], censoredRanges: [NSRange])? {
+    let matches = wordBanMatches(text: text, rules: rules)
+    if matches.isEmpty {
+        return nil
+    }
+    let result = NSMutableString(string: text)
+    var resultEntities = entities ?? []
+    var censoredRanges: [Range<Int>] = []
+
+    // From the end, so earlier ranges stay valid while later ones change length.
+    for match in matches.reversed() {
+        let start = match.range.location
+        let end = match.range.location + match.range.length
+        switch match.rule.mode {
+        case .censor:
+            censoredRanges.append(start ..< end)
+        case .replace:
+            let replacement = match.rule.replacement ?? ""
+            let replacementLength = (replacement as NSString).length
+            let delta = replacementLength - match.range.length
+            result.replaceCharacters(in: match.range, with: replacement)
+            resultEntities = resultEntities.compactMap { entity in
+                var entity = entity
+                let lower = entity.range.lowerBound
+                let upper = entity.range.upperBound
+                if upper <= start {
+                    return entity
+                }
+                if lower >= end {
+                    entity.range = (lower + delta) ..< (upper + delta)
+                    return entity
+                }
+                // Overlaps the replaced word: keep what is outside it, the replacement joins the entity.
+                let newLower = lower < start ? lower : start
+                let newUpper = upper > end ? upper + delta : start + replacementLength
+                if newUpper <= newLower {
+                    return nil
+                }
+                entity.range = newLower ..< newUpper
+                return entity
+            }
+            censoredRanges = censoredRanges.map { ($0.lowerBound + delta) ..< ($0.upperBound + delta) }
+        }
+    }
+    return (result as String, resultEntities, censoredRanges.map { NSRange(location: $0.lowerBound, length: $0.upperBound - $0.lowerBound) })
+}
+
+/// The banned words behind `matches`, each once, in text order: one per ban, however many times or forms it occurs.
+public func wordBanDistinctWords(_ matches: [WordBanMatch]) -> [String] {
+    var words: [String] = []
+    for match in matches where !words.contains(where: { wordBanKey($0) == wordBanKey(match.rule.word) }) {
+        words.append(match.rule.word)
+    }
+    return words
+}
diff --git a/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift
new file mode 100644
index 0000000000..8a932a6f45
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanCensorStripView.swift
@@ -0,0 +1,142 @@
+import Foundation
+import UIKit
+
+/// The censor bar over a banned word: a strip of paper laid across it. It is slightly tilted and casts a soft shadow,
+/// and when it appears it is pressed on from left to right: the part not yet stuck down is lifted and bent, and
+/// settles flat as the strip reaches the end.
+public final class WordBanCensorStripView: UIView {
+    /// The strip's tilt, counter-clockwise (the Figma reference: 1.35°).
+    public static let defaultTilt: CGFloat = -1.35 * .pi / 180.0
+
+    private let shapeLayer = CAShapeLayer()
+    private var currentSize = CGSize()
+
+    public var color: UIColor = .black {
+        didSet {
+            self.shapeLayer.fillColor = self.color.cgColor
+        }
+    }
+
+    override public init(frame: CGRect) {
+        super.init(frame: frame)
+
+        self.isUserInteractionEnabled = false
+        self.layer.addSublayer(self.shapeLayer)
+        self.shapeLayer.fillColor = self.color.cgColor
+        self.shapeLayer.shadowColor = UIColor.black.cgColor
+        self.shapeLayer.shadowOpacity = 0.24
+        self.shapeLayer.shadowRadius = 4.0
+        self.shapeLayer.shadowOffset = CGSize(width: 0.0, height: 2.0)
+    }
+
+    required public init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// Lays the strip out flat at `size` (set the view's bounds and center from outside; the tilt is a transform).
+    public func update(size: CGSize, tilt: CGFloat = WordBanCensorStripView.defaultTilt) {
+        self.transform = CGAffineTransform(rotationAngle: tilt)
+        if self.currentSize == size {
+            // A relayout of the same strip keeps a press-on animation running.
+            return
+        }
+        self.currentSize = size
+        self.shapeLayer.frame = CGRect(origin: CGPoint(), size: size)
+        self.shapeLayer.removeAnimation(forKey: "path")
+        self.shapeLayer.removeAnimation(forKey: "shadowOpacity")
+        self.shapeLayer.path = WordBanCensorStripView.path(size: size, progress: 1.0)
+    }
+
+    /// Presses the strip on from left to right. Under Reduce Motion it fades in instead.
+    public func animateIn(duration: Double = 0.45, delay: Double = 0.0) {
+        let size = self.currentSize
+        if size.width <= 0.0 || size.height <= 0.0 {
+            return
+        }
+        if UIAccessibility.isReduceMotionEnabled {
+            self.layer.animateAlphaFade(duration: 0.2, delay: delay)
+            return
+        }
+
+        // A critically damped spring on the progress: fast start, soft landing, no overshoot past the word.
+        let frameCount = 36
+        let omega = 9.0 / duration
+        var paths: [CGPath] = []
+        var shadows: [NSNumber] = []
+        for i in 0 ... frameCount {
+            let t = duration * Double(i) / Double(frameCount)
+            let progress = i == frameCount ? 1.0 : 1.0 - (1.0 + omega * t) * exp(-omega * t)
+            paths.append(WordBanCensorStripView.path(size: size, progress: CGFloat(progress)))
+            // A lifted flap throws a deeper shadow.
+            shadows.append(NSNumber(value: 0.24 + 0.16 * (1.0 - progress)))
+        }
+
+        let pathAnimation = CAKeyframeAnimation(keyPath: "path")
+        pathAnimation.values = paths
+        pathAnimation.duration = duration
+        pathAnimation.beginTime = CACurrentMediaTime() + delay
+        pathAnimation.fillMode = .backwards
+        pathAnimation.calculationMode = .linear
+        self.shapeLayer.add(pathAnimation, forKey: "path")
+
+        let shadowAnimation = CAKeyframeAnimation(keyPath: "shadowOpacity")
+        shadowAnimation.values = shadows
+        shadowAnimation.duration = duration
+        shadowAnimation.beginTime = pathAnimation.beginTime
+        shadowAnimation.fillMode = .backwards
+        self.shapeLayer.add(shadowAnimation, forKey: "shadowOpacity")
+    }
+
+    /// The strip with its first `progress` of the length stuck down. The rest is a flap lifted off the surface: it bends
+    /// up along a curve and is drawn a little thicker, being closer to the eye. Every path has the same number of
+    /// points, so the keyframes interpolate smoothly.
+    static func path(size: CGSize, progress: CGFloat) -> CGPath {
+        let length = size.width
+        let thickness = size.height
+        let progress = max(0.0, min(1.0, progress))
+
+        let attached = length * progress
+        let flapLength = min(length - attached, max(thickness * 2.4, length * 0.35) * (1.0 - progress))
+        let lift = thickness * 1.3 * (1.0 - progress)
+
+        let sampleCount = 10
+        var top: [CGPoint] = []
+        var bottom: [CGPoint] = []
+
+        // The stuck part: a flat run from the left edge to the attachment line.
+        top.append(CGPoint(x: 0.0, y: 0.0))
+        bottom.append(CGPoint(x: 0.0, y: thickness))
+        for i in 0 ... sampleCount {
+            let f = CGFloat(i) / CGFloat(sampleCount)
+            let x = attached + flapLength * f
+            let bend = f * f
+            let dy = -lift * bend
+            let grow = thickness * 0.18 * bend * (1.0 - progress)
+            top.append(CGPoint(x: x, y: dy - grow * 0.5))
+            bottom.append(CGPoint(x: x, y: thickness + dy + grow * 0.5))
+        }
+
+        let path = CGMutablePath()
+        path.move(to: top[0])
+        for point in top.dropFirst() {
+            path.addLine(to: point)
+        }
+        for point in bottom.reversed() {
+            path.addLine(to: point)
+        }
+        path.closeSubpath()
+        return path
+    }
+}
+
+private extension CALayer {
+    func animateAlphaFade(duration: Double, delay: Double) {
+        let animation = CABasicAnimation(keyPath: "opacity")
+        animation.fromValue = 0.0
+        animation.toValue = 1.0
+        animation.duration = duration
+        animation.beginTime = CACurrentMediaTime() + delay
+        animation.fillMode = .backwards
+        self.add(animation, forKey: "opacity")
+    }
+}
diff --git a/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanSimilar.swift b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanSimilar.swift
new file mode 100644
index 0000000000..d9a793c7fc
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatWordBan/Sources/WordBanSimilar.swift
@@ -0,0 +1,165 @@
+import Foundation
+import NaturalLanguage
+
+// MARK: - Similar words
+
+/// Endings a word form can add to a stem, Russian and English. Used when the system lemmatizer does not know a word
+/// (slang, names, interjections), so "дедлайнами" or "yous" still count as forms.
+private let wordBanFormEndings: [String] = [
+    "s", "es", "ed", "d", "ing", "er", "ers", "'s", "’s",
+    "а", "я", "ы", "и", "у", "ю", "е", "о", "ь", "й",
+    "ом", "ем", "ём", "ой", "ей", "ам", "ям", "ах", "ях", "ов", "ев", "ёв", "ую", "юю", "ая", "яя", "ое", "ее", "ые", "ие", "ий", "ый", "ой",
+    "ами", "ями", "ого", "его", "ому", "ему", "ыми", "ими", "ых", "их", "ым", "им", "ик", "ка", "ки", "ке", "ку", "кой", "чик"
+]
+private let wordBanVowels = Set("aeiouyаеёиоуыэюя")
+
+/// The word with each run of one repeated letter cut to one letter: "йоооу" → "йоу".
+func wordBanCollapsedRuns(_ word: String) -> String {
+    var result = ""
+    var previous: Character?
+    for character in word {
+        if character != previous {
+            result.append(character)
+        }
+        previous = character
+    }
+    return result
+}
+
+/// Whether the word ends in a run of one letter at least `count` long ("йооо": the "о" three times).
+private func wordBanEndsInStretch(_ word: String, atLeast count: Int) -> Bool {
+    guard let last = word.last else {
+        return false
+    }
+    return word.reversed().prefix(while: { $0 == last }).count >= count
+}
+
+/// The stems of a banned word a form can grow from: the word itself and, for a word ending in a vowel or "ь"/"й",
+/// the word without it ("работа" → "работ", for "работы", "работой").
+private func wordBanStems(_ key: String) -> [String] {
+    var stems = [key]
+    if let last = key.last, key.count >= 4, wordBanVowels.contains(last) || last == "ь" || last == "й" {
+        stems.append(String(key.dropLast()))
+    }
+    return stems
+}
+
+/// What a banned word matches with "Similar words" on, in folded and collapsed form.
+struct WordBanSimilarPattern {
+    let key: String
+    let collapsed: String
+    let lemma: String?
+    let stems: [String]
+
+    init(word: String) {
+        self.key = wordBanKey(word)
+        self.collapsed = wordBanCollapsedRuns(self.key)
+        self.lemma = wordBanLemma(of: self.key)
+        self.stems = wordBanStems(self.collapsed)
+    }
+
+    /// Whether `token` (folded) is the banned word, a form of it, or it stretched, cut short, or both.
+    func matches(token: String, tokenLemma: String?) -> Bool {
+        if token == self.key {
+            return true
+        }
+        let collapsedToken = wordBanCollapsedRuns(token)
+        // 1. Stretched letters: "йоооу", "йоуууу".
+        if collapsedToken == self.collapsed {
+            return true
+        }
+        // 2. Word forms: the same lemma, or a stem with a known ending ("дедлайны", "deadlines").
+        if let tokenLemma, let lemma = self.lemma, tokenLemma == lemma {
+            return true
+        }
+        if let tokenLemma, tokenLemma == self.key {
+            return true
+        }
+        for stem in self.stems where collapsedToken.hasPrefix(stem) {
+            let ending = String(collapsedToken.dropFirst(stem.count))
+            if !ending.isEmpty && wordBanFormEndings.contains(ending) {
+                return true
+            }
+        }
+        // 3. The beginning of the word, at least 2 letters and two thirds of it, with its last letter stretched: "йооо".
+        let minimumLength = max(2, Int((Double(self.collapsed.count) * 2.0 / 3.0).rounded(.up)))
+        if collapsedToken.count >= minimumLength && collapsedToken.count < self.collapsed.count && self.collapsed.hasPrefix(collapsedToken) && wordBanEndsInStretch(token, atLeast: 2) {
+            return true
+        }
+        return false
+    }
+}
+
+/// The dictionary form of one word, folded, as the system lemmatizer gives it; nil when it does not know the word.
+func wordBanLemma(of word: String) -> String? {
+    let tagger = NLTagger(tagSchemes: [.lemma])
+    tagger.string = word
+    let (tag, _) = tagger.tag(at: word.startIndex, unit: .word, scheme: .lemma)
+    guard let value = tag?.rawValue, !value.isEmpty else {
+        return nil
+    }
+    let folded = wordBanKey(value)
+    return folded
+}
+
+/// The words of a text with their UTF-16 ranges and, where the lemmatizer knows them, their folded dictionary forms.
+func wordBanTokens(_ text: String) -> [(range: NSRange, token: String, lemma: String?)] {
+    let tagger = NLTagger(tagSchemes: [.lemma])
+    tagger.string = text
+    var result: [(range: NSRange, token: String, lemma: String?)] = []
+    tagger.enumerateTags(in: text.startIndex ..< text.endIndex, unit: .word, scheme: .lemma, options: [.omitPunctuation, .omitWhitespace, .omitOther]) { tag, range in
+        let token = String(text[range])
+        if token.unicodeScalars.contains(where: { CharacterSet.alphanumerics.contains($0) }) {
+            let lemma = tag.flatMap { $0.rawValue.isEmpty ? nil : wordBanKey($0.rawValue) }
+            result.append((NSRange(range, in: text), wordBanKey(token), lemma))
+        }
+        return true
+    }
+    return result
+}
+
+/// Examples of the similar words a ban catches, one per rule, written from the word as the sheet shows it:
+/// stretched ("Йоооу"), a word form ("Йоуа"), cut short and stretched ("Йооо").
+public func wordBanSimilarExamples(_ word: String) -> (stretched: String, form: String, shortened: String) {
+    let characters = Array(word)
+    let lowerVowels = wordBanVowels
+    // Stretched: the first vowel three times.
+    var stretched = word + String(repeating: String(characters.last ?? " "), count: 2)
+    if let index = characters.firstIndex(where: { lowerVowels.contains(Character($0.lowercased())) }) {
+        var copy = characters
+        copy.insert(contentsOf: [characters[index], characters[index]], at: index + 1)
+        stretched = String(copy)
+    }
+    // Form: a plural-like ending in the word's script.
+    let isCyrillic = word.unicodeScalars.contains(where: { (0x0400 ... 0x04FF).contains($0.value) })
+    let isUpper = word.count > 1 && word == word.uppercased()
+    var form: String
+    let last = characters.last.map { Character($0.lowercased()) }
+    if isCyrillic {
+        switch last {
+        case "а": form = String(characters.dropLast()) + "ы"
+        case "я", "ь", "й": form = String(characters.dropLast()) + "и"
+        case "о": form = String(characters.dropLast()) + "а"
+        case "е": form = String(characters.dropLast()) + "я"
+        case let value? where wordBanVowels.contains(value): form = word + "ка"
+        default: form = word + "ы"
+        }
+    } else {
+        switch last {
+        case "s", "x", "z", "h": form = word + "es"
+        default: form = word + "s"
+        }
+    }
+    if isUpper {
+        form = form.uppercased()
+    }
+    // Shortened: the beginning, at least two letters and two thirds of the word, its last letter stretched.
+    let collapsed = Array(wordBanCollapsedRuns(word))
+    let length = min(collapsed.count, max(2, Int((Double(collapsed.count) * 2.0 / 3.0).rounded(.up))))
+    var prefix = Array(collapsed.prefix(length))
+    if prefix.count == collapsed.count && prefix.count > 2 {
+        prefix.removeLast()
+    }
+    let shortened = String(prefix) + String(repeating: String(prefix.last ?? " "), count: 2)
+    return (stretched, form, shortened)
+}
