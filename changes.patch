+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import UndoUI
+import ChatWordBan
+import WordBanScreen
+
+/// One-sided word ban in a chat: "Ban a Word" on a selected word opens the ban sheet, and the chat redraws its messages
+/// whenever the chat's bans change.
+extension ChatControllerImpl {
+    func presentWordBanScreen(message: EngineRawMessage?, word: String) {
+        guard let peerId = message?.id.peerId ?? self.chatLocation.peerId else {
+            return
+        }
+        let normalizedWord = wordBanNormalizedWord(word)
+        if normalizedWord.isEmpty {
+            return
+        }
+        let present: () -> Void = { [weak self] in
+            guard let self else {
+                return
+            }
+            self.chatDisplayNode.dismissInput()
+            let controller = WordBanScreen(context: self.context, peerId: peerId, word: normalizedWord, completion: { [weak self] result in
+                guard let self else {
+                    return
+                }
+                let presentationData = self.presentationData
+                switch result {
+                case let .banned(rule):
+                    self.present(UndoOverlayController(presentationData: presentationData, content: .actionSucceeded(title: nil, text: presentationData.strings.WordBan_Toast_Banned(rule.word).string, cancel: presentationData.strings.Undo_Undo, destructive: false), elevatedLayout: false, action: { action in
+                        if case .undo = action {
+                            WordBanStore.shared.removeRule(peerId: peerId, word: rule.word)
+                        }
+                        return false
+                    }), in: .current)
+                case let .unbanned(word):
+                    self.present(UndoOverlayController(presentationData: presentationData, content: .actionSucceeded(title: nil, text: presentationData.strings.WordBan_Toast_Unbanned(word).string, cancel: nil, destructive: false), elevatedLayout: false, action: { _ in
+                        return false
+                    }), in: .current)
+                }
+            })
+            self.push(controller)
+        }
+        if let currentContextController = self.currentContextController {
+            currentContextController.dismiss(completion: {
+                present()
+            })
+        } else {
+            present()
+        }
+    }
+
+    /// Redraws the visible messages of this chat when its bans change, so banned words hide or show at once.
+    func makeWordBanUpdatesDisposable() -> Disposable? {
+        guard let peerId = self.chatLocation.peerId else {
+            return nil
+        }
+        return (WordBanStore.shared.updated
+        |> filter { $0 == peerId }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] _ in
+            self?.updateWordBanMessages()
+        })
+    }
+
+    func updateWordBanMessages() {
+        var messageIds: [EngineMessage.Id] = []
+        self.chatDisplayNode.historyNode.forEachVisibleMessageItemNode { itemNode in
+            if let item = itemNode.item {
+                messageIds.append(item.message.id)
+            }
+        }
+        for id in messageIds {
+            self.chatDisplayNode.historyNode.requestMessageUpdate(id)
+        }
+    }
+}
