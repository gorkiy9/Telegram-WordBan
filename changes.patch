@@ -0,0 +1,748 @@
+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import TelegramCore
+import SwiftSignalKit
+import AccountContext
+import TelegramPresentationData
+import ComponentFlow
+import ViewControllerComponent
+import SheetComponent
+import MultilineTextComponent
+import BundleIconComponent
+import GlassBarButtonComponent
+import ButtonComponent
+import TabSelectorComponent
+import ListSectionComponent
+import ListTextFieldItemComponent
+import ListSwitchItemComponent
+import ChatTimerScreen
+import AppBundle
+import ChatWordBan
+
+private let replacementFieldTag = GenericComponentViewTag()
+private let replacementMaxLength = 32
+
+/// What the sheet shows for the word: left as is, or banned in one of two ways.
+private enum WordBanOption: Int, Equatable {
+    case visible = 0
+    case censor = 1
+    case replace = 2
+
+    init(mode: WordBanMode?) {
+        switch mode {
+        case .none:
+            self = .visible
+        case .censor:
+            self = .censor
+        case .replace:
+            self = .replace
+        }
+    }
+}
+
+private func durationTitle(_ duration: WordBanDuration, strings: PresentationStrings) -> String {
+    switch duration {
+    case .day:
+        return strings.WordBan_Duration_Day
+    case .week:
+        return strings.WordBan_Duration_Week
+    case .month:
+        return strings.WordBan_Duration_Month
+    case .threeMonths:
+        return strings.WordBan_Duration_3Months
+    case .sixMonths:
+        return strings.WordBan_Duration_6Months
+    case .year:
+        return strings.WordBan_Duration_Year
+    case .forever:
+        return strings.WordBan_Duration_Forever
+    }
+}
