+/// The sheet that bans a word selected in an incoming message: the word, how messages show it (Visible, Spoiler,
+/// Replace) and how long the ban lasts. The ban is local and one-sided (`WordBanStore`).
+public class WordBanScreen: ViewControllerComponentContainer {
+    public enum Result {
+        case banned(WordBanRule)
+        case unbanned(word: String)
+    }
+
+    private let peerId: EnginePeer.Id
+    private let word: String
+    private let initialRule: WordBanRule?
+    private let completion: (Result) -> Void
+
+    public init(context: AccountContext, peerId: EnginePeer.Id, word: String, completion: @escaping (Result) -> Void) {
+        let word = wordBanNormalizedWord(word)
+        let initialRule = WordBanStore.shared.rule(peerId: peerId, word: word)
+        self.peerId = peerId
+        self.word = initialRule?.word ?? word
+        self.initialRule = initialRule
+        self.completion = completion
+
+        super.init(
+            context: context,
+            component: WordBanSheetComponent(context: context, word: initialRule?.word ?? word, initialRule: initialRule),
+            navigationBarAppearance: .none,
+            statusBarStyle: .ignore,
+            theme: .default
+        )
+
+        self.navigationPresentation = .flatModal
+        self.supportedOrientations = ViewControllerSupportedOrientations(regularSize: .all, compactSize: .portrait)
+    }
+
+    required public init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    fileprivate func activateReplacementInput() {
+        if let view = self.node.hostView.findTaggedView(tag: replacementFieldTag) as? ListTextFieldItemComponent.View {
+            view.activateInput()
+        }
+    }
+
+    fileprivate func complete(option: WordBanOption, replacement: String, duration: WordBanDuration, includesSimilar: Bool) {
+        switch option {
+        case .visible:
+            if self.initialRule != nil {
+                WordBanStore.shared.removeRule(peerId: self.peerId, word: self.word)
+                self.completion(.unbanned(word: self.word))
+            }
+        case .censor, .replace:
+            let trimmedReplacement = replacement.trimmingCharacters(in: .whitespacesAndNewlines)
+            if option == .replace && trimmedReplacement.isEmpty {
+                if let view = self.node.hostView.findTaggedView(tag: replacementFieldTag) as? ListTextFieldItemComponent.View {
+                    view.animateError()
+                    HapticFeedback().error()
+                }
+                return
+            }
+            let expiresAt: Int32?
+            if let initialRule = self.initialRule, initialRule.duration == duration {
+                expiresAt = initialRule.expiresAt
+            } else {
+                expiresAt = duration.expirationTimestamp(from: Int32(Date().timeIntervalSince1970))
+            }
+            let rule = WordBanRule(
+                word: self.word,
+                mode: option == .censor ? .censor : .replace,
+                replacement: option == .replace ? trimmedReplacement : nil,
+                duration: duration,
+                expiresAt: expiresAt,
+                includesSimilar: includesSimilar
+            )
+            WordBanStore.shared.setRule(peerId: self.peerId, rule: rule)
+            self.completion(.banned(rule))
+        }
+        self.dismissAnimated()
+    }
+
+    public func dismissAnimated() {
+        self.view.endEditing(true)
+        if let view = self.node.hostView.findTaggedView(tag: SheetComponent<ViewControllerComponentContainer.Environment>.View.Tag()) as? SheetComponent<ViewControllerComponentContainer.Environment>.View {
+            view.dismissAnimated()
+        }
+    }
+}
