new file mode 100644
index 0000000000..e7b95e53a3
--- /dev/null
+++ b/submodules/TelegramUI/Sources/WordBanDemo.swift
@@ -0,0 +1,84 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ChatWordBan
+
+/// The word ban demo build's content (`isWordBanDemoBuild`): made-up people and chats, so the demo video shows nothing
+/// real. Written on the first launch, and again (with every ban cleared) on launch with `-WordBanDemoReset YES`.
+enum WordBanDemo {
+    private static let markerKey = "WordBanDemo.SeedVersion"
+    private static let markerVersion = 3
+
+    private static let leo = wordBanDemoPeerId(index: 0, isGroup: false)
+    private static let anna = wordBanDemoPeerId(index: 1, isGroup: false)
+    private static let sam = wordBanDemoPeerId(index: 2, isGroup: false)
+    private static let mia = wordBanDemoPeerId(index: 3, isGroup: false)
+    private static let productTeam = wordBanDemoPeerId(index: 0, isGroup: true)
+    private static let weekendHike = wordBanDemoPeerId(index: 1, isGroup: true)
+
+    static func prepare(context: AccountContext) {
+        guard isWordBanDemoBuild else {
+            return
+        }
+        let defaults = UserDefaults.standard
+        let reset = defaults.bool(forKey: "WordBanDemoReset")
+        if !reset && defaults.integer(forKey: WordBanDemo.markerKey) == WordBanDemo.markerVersion {
+            return
+        }
+        WordBanStore.shared.removeAll()
+        let _ = context.engine.messages.seedWordBanDemo(WordBanDemo.seed()).start(completed: {
+            defaults.set(WordBanDemo.markerVersion, forKey: WordBanDemo.markerKey)
+        })
+    }
+
+    private static func seed() -> WordBanDemoSeed {
+        let now = Int32(Date().timeIntervalSince1970)
+        var messages: [WordBanDemoSeed.Message] = []
+        var nextId: [EnginePeer.Id: Int32] = [:]
+        func add(_ peerId: EnginePeer.Id, _ minutesAgo: Int32, _ author: EnginePeer.Id?, _ text: String) {
+            let id = (nextId[peerId] ?? 0) + 1
+            nextId[peerId] = id
+            messages.append(WordBanDemoSeed.Message(peerId: peerId, id: id, authorId: author, timestamp: now - minutesAgo * 60, text: text))
+        }
+
+        // The chat the demo is about: a colleague who mentions the deadline in every other message.
+        add(leo, 95, leo, "Morning! Quick reminder: the deadline for the pitch deck is Friday.")
+        add(leo, 94, nil, "Got it, I'm on it")
+        add(leo, 60, leo, "Also, the client moved their deadline, so ours moves too 🙃")
+        add(leo, 58, nil, "Sure, send me the new date")
+        add(leo, 31, leo, "Can we sync at 3? I want to go over the deadline plan with you.")
+        add(leo, 30, nil, "Works for me")
+        add(leo, 6, leo, "Great. And please remember: a deadline is a deadline.")
+        add(leo, 2, leo, "Last one, promise. New deadline details tomorrow morning!")
+
+        add(anna, 240, anna, "Are we still on for dinner on Saturday?")
+        add(anna, 236, nil, "Of course! 7pm at the usual place?")
+        add(anna, 12, anna, "Perfect, I booked a table by the window 🍝")
+
+        add(productTeam, 180, sam, "Standup moved to 10:30 today")
+        add(productTeam, 120, mia, "New mockups are in the shared folder")
+        add(productTeam, 25, leo, "Everyone, the deadline is Friday. Friday!")
+
+        add(sam, 600, sam, "Thanks for the book recommendation, loved it")
+        add(sam, 590, nil, "Told you! The sequel is even better")
+
+        add(weekendHike, 900, mia, "Weather looks great for Sunday ☀️")
+        add(weekendHike, 880, anna, "I'll bring snacks")
+
+        add(mia, 1500, mia, "Can you send me the photos from the trip?")
+        add(mia, 1490, nil, "Sending tonight 📸")
+
+        return WordBanDemoSeed(
+            peers: [
+                WordBanDemoSeed.Peer(id: leo, kind: .user(firstName: "Leo", lastName: "Park"), unreadCount: 2, photo: WordBanDemoAvatars.leo),
+                WordBanDemoSeed.Peer(id: anna, kind: .user(firstName: "Anna", lastName: "Kovacs"), unreadCount: 1, photo: WordBanDemoAvatars.anna),
+                WordBanDemoSeed.Peer(id: productTeam, kind: .group(title: "Product Team", memberCount: 6), unreadCount: 3, photo: WordBanDemoAvatars.team),
+                WordBanDemoSeed.Peer(id: sam, kind: .user(firstName: "Sam", lastName: "Rivera"), photo: WordBanDemoAvatars.sam),
+                WordBanDemoSeed.Peer(id: weekendHike, kind: .group(title: "Weekend Hike", memberCount: 4), photo: WordBanDemoAvatars.hike),
+                WordBanDemoSeed.Peer(id: mia, kind: .user(firstName: "Mia", lastName: "Chen"), photo: WordBanDemoAvatars.mia)
+            ],
+            messages: messages
+        )
+    }
+}
